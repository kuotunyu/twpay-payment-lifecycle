# ---- Public base URL for gateway callbacks ----
# cloudflared: `cloudflared tunnel --url http://localhost:8000`,
#   then: uv run python scripts/update_tunnel_url.py https://xxxx.trycloudflare.com
# ngrok:  `ngrok http 8000`, then: uv run python scripts/update_tunnel_url.py
# No trailing slash. Gateways only accept port 80/443 — the tunnel https URL is fine.
BASE_URL=

# ---- ECPay (綠界) stage credentials ----
# Official PUBLIC test merchant — copy from https://developers.ecpay.com.tw/?p=2856
# (test backstage: https://vendor-stage.ecpay.com.tw/)
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ---- Optional: NewebPay contract-tested adapter ----
# The main ECPay lifecycle demo does not require these values.
# Register your own test store at https://cwww.newebpay.com/ (valid ~30 days),
# then copy MerchantID / HashKey / HashIV from 商店管理.
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
